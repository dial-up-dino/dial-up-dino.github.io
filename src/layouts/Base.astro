---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
	title?: string;
}

const { title = "Dial-Up Dino Games" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.png" type="image/png" />
		<title>{title}</title>
	</head>
	<body>
		<header
			class="flex flex-row flex-nowrap items-center justify-between bg-accent px-[50px] text-[20px] max-md:flex-col"
		>
			<a href="/">
				<img class="h-[140px] py-[20px]" src="/img/logo.svg" alt="Logo" />
			</a>
			<Nav />
		</header>
		<main class="mt-[20px] flex-1 px-[50px] text-[24px]">
			<slot />
		</main>
		<footer class="mt-[40px] bg-accent px-[50px] py-[20px] text-[20px] text-white">
			&copy; 2026 Dial-Up Dino Games
		</footer>
	</body>
</html>
